# --- Agents -------------------------------------------------------------
# Leave empty to use your local Claude Code login (e.g. Pro/Max plan via `claude login`).
# Set it to bill the Anthropic API instead.
ANTHROPIC_API_KEY=

# 1 = scripted fake agents + fake wallet/inbox. Costs $0; good for trying the UI.
MOCK_AGENTS=0
# Mock pacing multiplier (2 = twice as fast)
MOCK_SPEED=1

# Models per role (defaults: Sonnet for scout/research/market, Opus for the rest;
# with no API key everything defaults to Sonnet to stretch subscription limits)
# MODEL_SCOUT=claude-sonnet-5-5
# MODEL_RESEARCH=claude-sonnet-5-5
# MODEL_MARKET=claude-sonnet-5-5
# MODEL_VALIDATION=claude-opus-5-5
# MODEL_PLANNER=claude-opus-5-5
# MODEL_EXECUTOR=claude-opus-5-5

# --- First-run defaults (after first start, edit these in Settings) ------
DAILY_API_BUDGET_USD=5
PER_RUN_BUDGET_USD=0.75
WORKER_COUNT=2
PER_ACTION_CAP_USD=10
DAILY_SPEND_CAP_USD=50
DAILY_EMAIL_CAP=20
# Phone notifications for approvals, e.g. https://ntfy.sh/money-factory-<random-string>
NTFY_URL=

# --- Execution ------------------------------------------------------------
# Live execution stays impossible until this is true (phase 6, after reviewing paper results).
ENABLE_LIVE=false
# Referenced from config/mcp.json
PAYBOX_MCP_URL=
PAYBOX_TOKEN=
AGENTMAIL_API_KEY=

# --- Server -----------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
PUBLIC_URL=http://localhost:8787
DB_PATH=data/money-factory.db
TIMEZONE=Europe/Stockholm
